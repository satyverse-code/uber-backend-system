{
  "id": null,
  "title": "Uber - Booking KPIs",
  "tags": ["uber", "booking", "kpi"],
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "Ride Requests / min",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "rate(ride_requested_count[5m]) * 60",
          "legendFormat": "requests/min",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Ride Assigned / min",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "rate(ride_assigned_count[5m]) * 60",
          "legendFormat": "assigned/min",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Ride Failed / min",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "rate(ride_failed_count[5m]) * 60",
          "legendFormat": "failed/min",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Assignment Latency (p50/p90/p99)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(ride_assignment_latency_seconds_bucket[5m])) by (le))", "refId": "A", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.90, sum(rate(ride_assignment_latency_seconds_bucket[5m])) by (le))", "refId": "B", "legendFormat": "p90"},
        {"expr": "histogram_quantile(0.99, sum(rate(ride_assignment_latency_seconds_bucket[5m])) by (le))", "refId": "C", "legendFormat": "p99"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "type": "timeseries",
      "title": "Requests vs Assigned vs Failed (rate/min)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "rate(ride_requested_count[5m]) * 60", "refId": "A", "legendFormat": "requested"},
        {"expr": "rate(ride_assigned_count[5m]) * 60", "refId": "B", "legendFormat": "assigned"},
        {"expr": "rate(ride_failed_count[5m]) * 60", "refId": "C", "legendFormat": "failed"}
      ]
    }
  ],
  "templating": {"list": []}
}
