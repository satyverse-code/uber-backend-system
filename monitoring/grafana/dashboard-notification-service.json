      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Notification - 5xx Error Rate",
      "targets": [
        {"expr": "sum(rate(http_server_requests_seconds_count{application=\"notification-service\",status=~\"5..\"}[1m]))", "legendFormat": "5xx/s"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Notification - p95 Latency (s)",
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"notification-service\"}[5m])))", "legendFormat": "p95"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "type": "timeseries",
      "title": "Kafka Consumer Lag (notification group)",
      "targets": [
        {"expr": "sum(kafka_consumergroup_lag{consumergroup=\"notification-service-group\"})", "legendFormat": "lag"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    }
